# ==============================================================================
# PATEL NETWORKS / MEGATECH CCTV E-COMMERCE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Database architecture: self-hosted PostgreSQL on the client's VPS.
# Supabase has been fully removed (see ADR-022). No managed database services.
# NEVER commit real credentials or connection strings to version control.
# Copy this file to `.env` and fill in real values.
# See ENVIRONMENT-VARIABLES-GUIDE.md for detailed setup instructions per variable.
# ==============================================================================

# ---------------------------------------------
# APPLICATION
# ---------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------
# POSTGRESQL — SELF-HOSTED ON CLIENT VPS
# ---------------------------------------------
# Primary pooled connection (PgBouncer on the VPS, port 6432 by convention).
# Use this for application queries.
DATABASE_URL="postgresql://patelnetworks:CHANGE_ME@127.0.0.1:6432/patelnetworks?schema=public&sslmode=disable"

# Direct connection (bypasses PgBouncer) — required by Prisma for migrations.
DIRECT_URL="postgresql://patelnetworks:CHANGE_ME@127.0.0.1:5432/patelnetworks?schema=public&sslmode=disable"

# Production override example (Docker / VPS):
# DATABASE_URL="postgresql://patelnetworks:CHANGE_ME@db:5432/patelnetworks?schema=public"
# DIRECT_URL="postgresql://patelnetworks:CHANGE_ME@db:5432/patelnetworks?schema=public"

# ---------------------------------------------
# AUTHENTICATION & SECURITY
# ---------------------------------------------
# Generate a 32+ byte random string: openssl rand -base64 48
JWT_SECRET="replace_with_a_secure_random_32_byte_string_for_jwt"
JWT_EXPIRES_IN="7d"

# Admin login fallback (defaults defined in admin-auth.service.ts):
#   ADMIN_EMAIL defaults to: superadmin@patelnetworks.in
#   ADMIN_PASSWORD defaults to: <see admin-auth.service.ts>
# Override below only if you want to change them:
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""

# ---------------------------------------------
# RAZORPAY PAYMENT GATEWAY (SIMULATION MODE — placeholder keys)
# Replace with real keys from https://dashboard.razorpay.com/
# ---------------------------------------------
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"
# Client-side key (exposed to browser — must be the public test/live key)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"

# ---------------------------------------------
# WHATSAPP BUSINESS API (SIMULATION MODE — placeholder keys)
# Replace with credentials from Meta Business Suite / Gupshup
# ---------------------------------------------
WHATSAPP_API_URL="https://graph.facebook.com/v20.0"
WHATSAPP_ACCESS_TOKEN="placeholder_whatsapp_access_token"
WHATSAPP_PHONE_NUMBER_ID="placeholder_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="placeholder_business_account_id"
WHATSAPP_VERIFY_TOKEN="placeholder_whatsapp_verify_token"

# ---------------------------------------------
# SHIPPING INTEGRATIONS (SIMULATION MODE)
# ---------------------------------------------
SHIPROCKET_EMAIL="placeholder@patelnetworks.com"
SHIPROCKET_PASSWORD="placeholder_shiprocket_password"
SHIPROCKET_API_URL="https://apiv2.shiprocket.in/v1/external"

# ---------------------------------------------
# SMS OTP GATEWAY (SIMULATION MODE)
# ---------------------------------------------
SMS_GATEWAY_API_KEY="placeholder_sms_api_key"
SMS_SENDER_ID="PTLNET"

# ---------------------------------------------
# MEDIA STORAGE (CLOUDINARY / AWS S3) - placeholder
# ---------------------------------------------
CLOUDINARY_CLOUD_NAME="placeholder_cloud_name"
CLOUDINARY_API_KEY="placeholder_api_key"
CLOUDINARY_API_SECRET="placeholder_api_secret"
